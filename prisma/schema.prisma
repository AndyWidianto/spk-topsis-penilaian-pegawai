datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}


// model users
model Users {
  id        Int      @id() @default(autoincrement())
  email     String 
  username  String 
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt 
  
  @@map("users")
}

// model employee
enum EmployeeStatus {
  active
  inactive
}
model Employees {
  id          Int         @id()  @default(autoincrement())
  nip         String
  name        String
  position    String
  division    String
  status      EmployeeStatus
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  assessments Assessments[]

  @@map("employees")
}

enum CriteriaType {
  benefit
  cost
} 

enum StatusCriteria {
  active
  inactive
}

model Criterias {
  id                    Int              @id()   @default(autoincrement())
  code                  String
  name                  String
  weight                Int
  type                  CriteriaType
  description           String
  status                StatusCriteria   @default(active)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  assessemnt_details     AssessmentDetails[]
  @@map("criterias")
}


enum StatusPriode {
  active
  finished
}
model Priodes {
  id              Int             @id()   @default(autoincrement())
  month           Int
  year            Int 
  status          StatusPriode
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  assessments     Assessments[]

  @@map("priodes")
}


model Assessments {
  id                    Int       @id()  @default(autoincrement())
  employee_id           Int 
  priode_id             Int
  total_value           Decimal?   @db.Decimal(10, 6)
  ranking               Int?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  assessemnt_details     AssessmentDetails[]
  employees             Employees @relation(fields: [employee_id], references: [id])
  priodes               Priodes   @relation(fields: [priode_id], references: [id])
  @@unique([employee_id, priode_id])

  @@map("assessments")
}

model AssessmentDetails {
  id            Int           @id()   @default(autoincrement())
  assessment_id  Int 
  criteria_id   Int
  nilai         Int
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  assessments   Assessments    @relation(fields: [assessment_id], references: [id])
  criterias     Criterias     @relation(fields: [criteria_id], references: [id])

  @@map("assessment_details")
}
