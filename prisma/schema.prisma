datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}


// model users
enum RoleUser {
  super_admin
  admin
  user
}
model Users {
  id                Int      @id() @default(autoincrement())
  email             String 
  username          String 
  password          String
  avatar            String?
  refresh_token     String?  @db.Text
  role              RoleUser @default(user)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt 
  notifications     Notifications[]
  audit_logs        AuditLogs[]
  
  @@map("users")
}

// model employee
enum EmployeeStatus {
  active
  inactive
}
model Employees {
  id          Int         @id()  @default(autoincrement())
  nip         String
  name        String
  position    String
  division    String
  status      EmployeeStatus
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  assessments Assessments[]

  @@map("employees")
}

enum CriteriaType {
  benefit
  cost
} 

enum StatusCriteria {
  active
  inactive
}

model Criterias {
  id                    Int              @id()   @default(autoincrement())
  code                  String
  name                  String
  weight                Int
  type                  CriteriaType
  description           String
  status                StatusCriteria   @default(active)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  assessment_details     AssessmentDetails[]
  @@map("criterias")
}


enum StatusPriode {
  active
  finished
}
model Priodes {
  id              Int             @id()   @default(autoincrement())
  month           Int
  year            Int 
  status          StatusPriode
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  assessments     Assessments[]

  @@map("priodes")
}


model Assessments {
  id                    Int       @id()  @default(autoincrement())
  employee_id           Int 
  priode_id             Int
  total_value           Decimal?   @db.Decimal(10, 6)
  ranking               Int?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  assessment_details    AssessmentDetails[]
  employees             Employees @relation(fields: [employee_id], references: [id])
  priodes               Priodes   @relation(fields: [priode_id], references: [id])
  @@unique([employee_id, priode_id])

  @@map("assessments")
}

model AssessmentDetails {
  id            Int           @id()   @default(autoincrement())
  assessment_id  Int 
  criteria_id   Int
  nilai         Int
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  assessments   Assessments    @relation(fields: [assessment_id], references: [id])
  criterias     Criterias     @relation(fields: [criteria_id], references: [id])

  @@map("assessment_details")
}

enum TypeNotification {
  info
  success
  warning
  error
}
enum TargetRole {
  super_admin
  admin
  all
}
model Notifications {
  id          Int       @id()  @default(autoincrement())
  user_id     Int? 
  message     String
  read        Boolean          @default(false)
  type        TypeNotification @default(success)
  target_role TargetRole       @default(all)
  action_url  String   
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  users       Users?    @relation(fields: [user_id], references: [id])

  @@map("notifications")
}

model AuditLogs {
  id              Int       @id()     @default(autoincrement())
  user_id         Int
  user_role       RoleUser
  action          String
  entity          String
  entity_id       Int
  ip_address      String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users           Users    @relation(fields: [user_id], references: [id])

  @@map("audit_logs")
}
